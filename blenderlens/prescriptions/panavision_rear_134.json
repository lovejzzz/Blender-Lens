{
  "meta": {
    "name": "Panavision 后置 1.34× 变形（US 7,085,066 原处方：变焦镜 + 8 片后置变形组），变焦 Z1（变焦镜单独 15.3 mm）",
    "short_name": "Panavision 后置 1.34×（真实处方）",
    "order": 4,
    "tagline": "唯一公开的 Panavision 变形处方：后置变形组，16:9 画幅解挤压到 2.40:1；变焦镜取短焦端 Z1",
    "note": "Iain A. Neil 为 Panavision 设计，2004 申请、2006 授权。后置变形组位于变焦镜与反光镜之间约 26 mm 内；前 46 面是 US 6,122,111 的变焦镜（Z1（变焦镜单独 15.3 mm）、无穷远；变焦间隔取自该专利 TABLE 1）。口径为专利在 Z1 下给出的光束高度。",
    "units": "mm",
    "conventions": {
      "origin": "像面（传感器）",
      "object_side": "+Z",
      "light_travels": "-Z",
      "surface_order": "从物方到像方",
      "radius_sign": "R > 0：曲率中心在像方（-Z 一侧）；R < 0：在物方；null = 平面（无穷大）",
      "surface_z": "z = z_vertex - sag(x, y)",
      "d": "该面到下一面的轴上距离（专利原值，使用时乘该组 scale）",
      "medium": "该面之后（像方一侧）的介质",
      "cylinder": "柱面镜只在水平主截面（x）有光焦度：R_y = null",
      "aperture": "每面 aperture 为物理 mm（已缩放，不再乘 scale）：柱面镜片 rect(semi_x, semi_y)；球面镜片 circle(clear 通光半径, outer 外半径，二者之间为黑色平台)"
    }
  },
