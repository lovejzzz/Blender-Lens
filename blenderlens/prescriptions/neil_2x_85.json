{
  "meta": {
    "name": "Neil 2× 现代前置变形 85 mm（Sirui 专利 CN 111562632 B，f/3）",
    "short_name": "Neil 2× 现代变形 85 mm（真实处方）",
    "order": 8,
    "tagline": "Iain Neil（Panavision 后置变形组的设计者）为思锐设计的现代 2× 前置变形：同一前组配三个可换后组；内对焦、无呼吸式凸轮",
    "note": "专利实施例原样收录（不是 Panavision 镜头）。前变形部分 G1：X 柱面 3 片、Y 柱面 3 片加球面；G1b 两片整体移动对焦。像面在专利里取 X/Y 柱面以模拟弯曲物面，这里用平面传感器，所以边缘有该设计本身的场曲。",
    "units": "mm",
    "conventions": {
      "origin": "像面（传感器）",
      "object_side": "+Z",
      "light_travels": "-Z",
      "surface_order": "从物方到像方",
      "radius_sign": "R > 0：曲率中心在像方（-Z 一侧）；R < 0：在物方；null = 平面（无穷大）",
      "surface_z": "z = z_vertex - sag(x, y)",
      "d": "该面到下一面的轴上距离（专利原值，使用时乘该组 scale）",
      "medium": "该面之后（像方一侧）的介质",
      "cylinder": "柱面镜只在水平主截面（x）有光焦度：R_y = null",
      "aperture": "每面 aperture 为物理 mm（已缩放，不再乘 scale）：柱面镜片 rect(semi_x, semi_y)；球面镜片 circle(clear 通光半径, outer 外半径，二者之间为黑色平台)"
    }
  },
